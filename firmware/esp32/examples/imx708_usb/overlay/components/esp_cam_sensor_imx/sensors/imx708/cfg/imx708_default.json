{
    "version": 1,
    "IMX708":
    {
        "adn": {
            "bf":
            [
                {
                    "gain": 1,
                    "param": {
                        "level": 3,
                        "matrix":
                        [
                            1, 2, 1,
                            2, 4, 2,
                            1, 2, 1
                        ]
                    }
                },
                {
                    "gain": 4,
                    "param": {
                        "level": 6,
                        "matrix":
                        [
                            1, 2, 1,
                            2, 4, 2,
                            1, 2, 1
                        ]
                    }
                },
                {
                    "gain": 8,
                    "param": {
                        "level": 8,
                        "matrix":
                        [
                            1, 2, 1,
                            2, 4, 2,
                            1, 2, 1
                        ]
                    }
                }
            ]
        },
        "agc":
        {
            "exposure":
            {
                "frame_delay": 2,
                "adjust_delay": 0
            },
            "gain":
            {
                "min_step": 0.0001,
                "frame_delay": 2,
                "max": 16
            },
            "anti_flicker":
            {
                "mode": "full",
                "ac_freq": 50
            },
            "f_n0": 1,
            "luma_adjust":
            {
                "target_low": 94,
                "target_high": 106,
                "target": 100,
                "low_threshold": 30,
                "low_regions": 10,
                "high_threshold": 220,
                "high_regions": 1,
                "weight":
                [
                    1, 1, 1, 1, 1,
                    1, 4, 4, 4, 1,
                    1, 4, 9, 4, 1,
                    1, 4, 4, 4, 1,
                    1, 1, 1, 1, 1
                ]
            },
            "mode": "high_light_priority",
            "high_light_priority":
            {
                "low_threshold": 120,
                "high_threshold": 230,
                "weight_offset": 0,
                "luma_offset": 0
            },
            "low_light_priority":
            {
                "low_threshold": 40,
                "high_threshold": 80,
                "weight_offset": 10,
                "luma_offset": 10
            }
        },
        "aen": {
            "gamma":
            {
                "use_gamma_param": false,
                "luma_env": "ae.luma.avg",
                "luma_min_step": 16.0,
                "table":
                [
                    {
                        "luma": 71.1,
                        "gamma_param": 0.72,
                        "red": {"x": [16, 32, 48, 64, 80, 96, 112, 128, 144, 160, 176, 192, 208, 224, 240, 255], "y": [35, 57, 77, 94, 111, 126, 141, 155, 169, 182, 195, 208, 220, 232, 244, 255]},
                        "green": {"x": [16, 32, 48, 64, 80, 96, 112, 128, 144, 160, 176, 192, 208, 224, 240, 255], "y": [35, 57, 77, 94, 111, 126, 141, 155, 169, 182, 195, 208, 220, 232, 244, 255]},
                        "blue": {"x": [16, 32, 48, 64, 80, 96, 112, 128, 144, 160, 176, 192, 208, 224, 240, 255], "y": [35, 57, 77, 94, 111, 126, 141, 155, 169, 182, 195, 208, 220, 232, 244, 255]}
                    }
                ]
            },
            "sharpen":
            [
                {
                    "gain": 1,
                    "param": {
                        "h_thresh": 56,
                        "l_thresh": 10,
                        "h_coeff": 0.400,
                        "m_coeff": 0.600,
                        "matrix":
                        [
                            1, 2, 1,
                            2, 2, 2,
                            1, 2, 1
                        ]
                    }
                },
                {
                    "gain": 8,
                    "param": {
                        "h_thresh": 80,
                        "l_thresh": 24,
                        "h_coeff": 0.250,
                        "m_coeff": 0.350,
                        "matrix":
                        [
                            1, 2, 1,
                            2, 2, 2,
                            1, 2, 1
                        ]
                    }
                }
            ],
            "contrast":
            [
                {
                    "gain": 1,
                    "value": 128
                }
            ]
        },
        "ian":
        {
            "luma":
            {
                "ae":
                {
                    "weight":
                    [
                        1, 1, 1, 1, 1,
                        1, 4, 4, 4, 1,
                        1, 4, 9, 4, 1,
                        1, 4, 4, 4, 1,
                        1, 1, 1, 1, 1
                    ]
                }
            }
        },
        "awb":
        {
            "model": 0,
            "min_counted": 1000,
            "min_red_gain_step": 0.5,
            "min_blue_gain_step": 0.5,
            "red_gain_scale": 1.0,
            "blue_gain_scale": 1.0,
            "range":
            {
                "green": { "max": 220, "min": 180 },
                "rg":    { "max": 0.8899, "min": 0.5040 },
                "bg":    { "max": 0.7822, "min": 0.4838 }
            },
            "green_luma_env": "ae.luma.avg",
            "green_luma_init": 200,
            "green_luma_step_ratio": 0.3
        },
        "af":
        {
            "//": "Contrast-detect autofocus driving the DW9807 VCM at I2C 0x0c. The ISP scores 'definition' (edge energy) inside the windows below; the algorithm hill-climbs the lens position that maximises it. Requires CONFIG_ESP_IPA_AF_ALGORITHM - this block names the esp_ipa_af unit, and if that unit is not compiled in the whole IPA config fails to resolve and you lose AE and AWB along with focus.",

            "//windows": "Three non-overlapping windows across the horizontal centre band of the 1920x1080 frame, weighted towards the middle. Frame edges are deliberately excluded: they are the softest part of the lens and the most likely to hold a foreground distraction, and either one pulls focus off the subject.",
            "windows":
            [
                { "left": 240,  "top": 340, "width": 480, "height": 400, "weight": 1 },
                { "left": 720,  "top": 340, "width": 480, "height": 400, "weight": 2 },
                { "left": 1200, "top": 340, "width": 480, "height": 400, "weight": 1 }
            ],

            "//edge_thresh": "Pixels whose edge response is below this contribute nothing. Too low and sensor noise reads as detail; too high and a low-contrast scene produces no AF signal at all. Lowered from 16 to the esp_ipa default of 10 because the measured scene contrast here is modest - mean |dG/dx| ran about 2 counts on a 0-63 green scale, i.e. roughly 8/255 - so a threshold of 16 risked rejecting most real edges.",
            "edge_thresh": 10,

            "//scan_band": "Wide / NoIR: official Raspberry Pi libcamera map is 420 at infinity to 920 at 35 dioptres. Scan 400..720 to cover calibration margin and normal face distances; validate on this physical lens, do not reuse a regular-module measurement.",
            "min_pos": 400,
            "max_pos": 720,

            "//scan_points": "Two 10-point contrast scans across the configured band.",
            "l1_scan_points_num": 10,
            "l2_scan_points_num": 10,

            "//restart": "Contrast/luma changes can trigger rescans; periodic rescan is 30 seconds to reduce visible hunting.",
            "definition_high_threshold_ratio": 1.5,
            "definition_low_threshold_ratio": 0.5,
            "luminance_high_threshold_ratio": 1.5,
            "luminance_low_threshold_ratio": 0.5,
            "max_change_time": 30000000
        },
        "acc": {
            "blc": {
                "model": 0,
                "stretch": true,
                "blc_table": [
                    { "gain": 1, "blc_param": {
                        "blc_top_left": 16, "blc_top_right": 16,
                        "blc_bottom_left": 16, "blc_bottom_right": 16
                    } }
                ]
            },
            "saturation":
            [
                {
                    "color_temp": 0,
                    "value": 128
                }
            ],
            "ccm":
            {
                "low_luma":
                {
                    "luma_env": "ae.luma.avg",
                    "threshold": 28,
                    "matrix":
                    [
                        1.00, 0.00, 0.00,
                        0.00, 1.00, 0.00,
                        0.00, 0.00, 1.00
                    ]
                },
                "table":
                [
                    {
                        "color_temp": 0,
                        "matrix":
                        [
                             1.6000, -0.4000, -0.2000,
                            -0.3000,  1.5500, -0.2500,
                            -0.1500, -0.5500,  1.7000
                        ]
                    }
                ]
            }
        }
    }
}
